# Frontend env (Next.js) — python-backend branch
#
# This branch has NO database access from the frontend. All data access
# goes through the FastAPI backend (see backend/.env.example), proxied
# transparently via the /api/* rewrite in next.config.js.

# Base URL of the FastAPI backend. Server-side only (never sent to the
# browser) — used by next.config.js to proxy /api/* requests.
# Local dev: http://localhost:8000
# Production: your Contabo VPS URL, e.g. https://api.yourdomain.com
BACKEND_URL="http://localhost:8000"

# Must be the EXACT SAME value as JWT_SECRET in backend/.env — the frontend
# verifies the JWT locally (in middleware) to gate page navigation, while the
# backend verifies it independently on every API request.
JWT_SECRET="change-me-to-a-long-random-secret"
