# PostgreSQL connection (e.g. Neon, Supabase, Vercel Postgres)
# DATABASE_URL = pooled connection (used at runtime by the app)
# DIRECT_URL   = direct connection (used by `prisma db push` / migrations)
#
# With Neon: DATABASE_URL uses the "-pooler" host, DIRECT_URL the plain host.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Secret used to sign auth JWTs — change this to a long random string
JWT_SECRET="change-me-to-a-long-random-secret"
