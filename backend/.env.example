# PostgreSQL 16 — asyncpg driver
# Local (docker compose): postgresql+asyncpg://admiral:admiral@db:5432/admiral
# Local (no docker):      postgresql+asyncpg://admiral:admiral@localhost:5432/admiral
DATABASE_URL="postgresql+asyncpg://admiral:admiral@localhost:5432/admiral"

# Must be the EXACT SAME value as JWT_SECRET in the frontend's .env.local —
# both sides sign/verify the same token.
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_DAYS="7"

# Comma-separated list of origins allowed to call this API directly
# (not required for the Next.js rewrite proxy, but useful for local tooling
# / direct API testing via curl, Postman, etc.)
CORS_ORIGINS="http://localhost:3000"

COOKIE_NAME="auth-token"
# "lax" works for local dev (same host, different ports). In production with
# frontend on Vercel and backend on a different domain, cross-site cookie
# delivery to the browser generally requires "none" + Secure + HTTPS, AND/OR
# a shared parent domain (see README "Production domain setup").
COOKIE_SAMESITE="lax"
COOKIE_SECURE="false"

ENVIRONMENT="development"
